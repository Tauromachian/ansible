#!/bin/bash

if [ "$EUID" -eq 0 ]; then
  echo "Error: Ansible will fail if you run this as root or with sudo"
  echo "Please run it as a regular user."
  exit 1
fi

if [ $# -eq 0 ]; then
    echo "Error: No arguments provided"
    echo "Please enter a tag. Possible arguments include home, work or wsl"
    exit 1
fi

if [ "$1" != "home" ] && [ "$1" != "work" ] && [ "$1" != "wsl" ]; then
    echo "Error: Invalid argument"
    echo "Please enter a tag. Either home, work or wsl"
    exit 1
fi

if [ ! -f /etc/os-release ]; then
    echo "Error: Cannot detect the operating system (/etc/os-release not found)"
    exit 1
fi

. /etc/os-release

case "$ID $ID_LIKE" in
    *debian*|*ubuntu*)
        if ! command -v ansible > /dev/null 2>&1; then
            sudo apt install -y software-properties-common
            sudo apt-add-repository -y ppa:ansible/ansible
            sudo apt update -y && sudo apt upgrade -y
            sudo apt install -y ansible
        fi
        ;;
    *arch*)
        if ! command -v ansible > /dev/null 2>&1; then
            sudo pacman -Syu --needed ansible
        fi
        ;;
    *)
        echo "Error: Unsupported distribution: ${PRETTY_NAME:-$ID}"
        echo "Supported distributions: Debian-based or Arch-based"
        exit 1
        ;;
esac

ansible-playbook ansible.yml --ask-become-pass --tags "$1"
